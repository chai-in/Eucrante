{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eucrante",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "AUTH_MODE": "access",
    "PUBLIC_BASE_URL": "https://eucrante.example.com"
  },
  "r2_buckets": [
    {
      "binding": "JOBS",
      "bucket_name": "eucrante-jobs"
    }
  ],
  "containers": [
    {
      "class_name": "CobaltContainer",
      "image": "./container/Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COBALT_CONTAINER",
        "class_name": "CobaltContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CobaltContainer"]
    }
  ]
}
